# Salin ke .env.local (lokal) atau isi di Vercel > Settings > Environment Variables
# JANGAN commit file .env / .env.local

# URL ERPNext, SATU skema saja, tanpa path
ERPNEXT_URL=https://erp.contoh.com
# API key & secret user ERPNext (generate BARU, key lama sudah bocor)
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Opsional
DEFAULT_COMPANY=

# Upstash Redis (Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Purchase Receipt: 1 = langsung submit, kosong/0 = draft
PR_SUBMIT=0
