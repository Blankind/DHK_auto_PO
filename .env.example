# Salin ke .env.local (lokal) atau isi di Vercel > Settings > Environment Variables
# JANGAN commit file .env / .env.local

# URL ERPNext, SATU skema saja, tanpa path
ERPNEXT_URL=https://erp.contoh.com
# API key & secret user ERPNext (generate BARU, key lama sudah bocor)
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Opsional
DEFAULT_COMPANY=

# Upstash Redis (Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Harga jual untuk kolom "Price List Rate Selling" di item PO
SELLING_PRICE_LISTS=Grosir,88,LM 88
# fieldname kolom di Purchase Order Item (cek di Customize Form)
PO_SELLING_FIELD=price_list_rate_selling
